<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scu.mapper.TemplateDataMapper">
    <!-- 获取所有数据 -->
    <select id="getAllTemplateData" resultType="HashMap">
        SELECT * FROM template_data_${templateId}
    </select>
    <!-- 获取审核通过的数据 status=2 -->
    <select id="getAuditedTemplateData" resultType="HashMap">
        SELECT * FROM template_data_${templateId} WHERE status = 2
    </select>
    <!-- 获取未审核的数据 status=0 -->
    <select id="getUnAuditedTemplateData" resultType="HashMap">
        SELECT * FROM template_data_${templateId} WHERE status = 0
    </select>
    <!-- 更新状态为审核通过 status=2 -->
    <update id="updateStatusToPass">
        UPDATE template_data_${templateId} SET status = 2 
        WHERE id IN 
        <foreach collection="templateDataId" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
    <!-- 更新状态为审核拒绝 status=1 -->
    <update id="updateStatusToReject">
        UPDATE template_data_${templateId} SET status = 1 
        WHERE id IN 
        <foreach collection="templateDataId" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>